---
const today = new Date();
---
<footer class="site-footer">
	<div class="footer-inner"><span>© {today.getFullYear()} HaloMoon</span><nav aria-label="页脚导航"><a href="/about">关于</a><a href="https://github.com/Hole333/HolyLinux">GitHub</a></nav></div>
</footer>
<style>.site-footer{min-height:var(--footer-height);display:flex;align-items:center;color:var(--secondary);font-family:Georgia,'Songti SC',serif;font-size:.8rem}.footer-inner{width:min(var(--nav-width),calc(100% - 40px));margin:auto;display:flex;justify-content:space-between;gap:1rem}.site-footer nav{display:flex;gap:1.2rem}.site-footer a{color:var(--secondary);text-decoration:none}.site-footer a:hover{color:var(--primary)}@media(max-width:560px){.footer-inner{width:calc(100% - 24px);flex-direction:column;align-items:center;gap:.5rem;padding-block:1.5rem}}</style>

