---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<header class="site-header"><nav aria-label="主导航"><div class="brand"><slot name="avatar"/><a class="wordmark" href="/" aria-label="HaloMoon 首页">{SITE_TITLE}</a></div><div class="nav-actions"><div class="internal-links"><HeaderLink href="/blog">文章</HeaderLink><HeaderLink href="/tags">标签</HeaderLink><HeaderLink href="/about">关于</HeaderLink><a href="https://github.com/Hole333/HolyLinux" target="_blank" rel="noreferrer">源码</a></div><button class="theme-toggle" type="button" aria-label="切换深浅色" title="切换深浅色"><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.2A8.7 8.7 0 0 1 8.8 3.5 9 9 0 1 0 20.5 15.2Z" fill="currentColor"/></svg><svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></div></nav></header>
<style>.brand{display:flex;align-items:center;gap:.6rem;min-width:0;flex-shrink:0}.site-header{height:var(--header-height);display:flex;align-items:center}.site-header nav{width:min(var(--nav-width),calc(100% - 40px));margin:auto;display:flex;align-items:center;justify-content:space-between;gap:2rem}.wordmark{font-family:Georgia,'Times New Roman','Songti SC',serif;font-size:1.55rem;font-weight:700;font-style:italic;letter-spacing:-.04em;color:var(--primary);text-decoration:none;background-size:240% 100%}@supports ((-webkit-background-clip:text) or (background-clip:text)){@media (hover:hover) and (pointer:fine){.wordmark:hover{color:transparent;background-image:linear-gradient(90deg,#ff5f57,#febc2e,#28c840,#39c5cf,#4f86f7,#ad76bc,#ff5f57);-webkit-background-clip:text;background-clip:text;animation:wordmark-rainbow 1.8s linear infinite}}.wordmark:focus-visible{color:transparent;background-image:linear-gradient(90deg,#ff5f57,#febc2e,#28c840,#39c5cf,#4f86f7,#ad76bc,#ff5f57);-webkit-background-clip:text;background-clip:text;animation:wordmark-rainbow 1.8s linear infinite}}@keyframes wordmark-rainbow{from{background-position:0 50%}to{background-position:240% 50%}}.nav-actions,.internal-links{display:flex;align-items:center;gap:.3rem}.internal-links a{padding:.5rem .68rem;border-radius:999px;color:var(--secondary);font-family:Georgia,'Songti SC',serif;font-size:.9rem;text-decoration:none;transition:background-color 160ms ease,color 160ms ease}.internal-links a:hover,.internal-links a.active{background:var(--surface-muted);color:var(--primary)}.theme-toggle{display:grid;place-items:center;width:36px;height:36px;margin-left:.3rem;padding:0;border:1px solid var(--border-soft);border-radius:50%;background:transparent;color:var(--secondary);cursor:pointer;transition:background-color 160ms ease,color 160ms ease}.theme-toggle:hover{background:var(--surface-muted);color:var(--primary)}.theme-toggle svg{width:17px;height:17px}.sun,html[data-theme='dark'] .moon{display:none}html[data-theme='dark'] .sun{display:block}@media(prefers-reduced-motion:reduce){.wordmark:hover,.wordmark:focus-visible{animation:none!important;background-position:50% 50%!important}}@media(max-width:720px){.site-header nav{width:min(100% - 24px,var(--nav-width))}.wordmark{font-size:1.15rem}.internal-links{gap:0}.internal-links a{padding:.45rem;font-size:.8rem}.internal-links a:nth-child(2),.internal-links a:nth-child(3),.internal-links a:nth-last-child(1){display:none}.theme-toggle{width:32px;height:32px}}</style>
