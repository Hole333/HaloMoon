<script>
  type SiteEffectsController = { init: () => void; cleanup: () => void };
  type SiteWindow = Window & { __haloSiteEffects?: SiteEffectsController };
  const siteWindow = window as SiteWindow;
  if (!siteWindow.__haloSiteEffects) {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
    const effects = new Map<HTMLElement, number>();
    const easeOut = 'cubic-bezier(0.23, 1, 0.32, 1)';
    let lastTrail = { x: 0, y: 0, time: 0 };
    let mistPhase = 0;
    const removeEffect = (element: HTMLElement) => {
      clearTimeout(effects.get(element));
      element.getAnimations({ subtree: true }).forEach(animation => animation.cancel());
      element.remove();
      effects.delete(element);
    };
    const cleanup = () => {
      for (const element of effects.keys()) removeEffect(element);
      lastTrail = { x: 0, y: 0, time: 0 };
    };
    const allowed = () => !document.hidden && !reduceMotion.matches && finePointer.matches;
    const place = (kind: string, x: number, y: number, lifetime: number) => {
      while (effects.size >= 18) removeEffect(effects.keys().next().value!);
      const element = document.createElement('span');
      element.className = kind;
      element.setAttribute('aria-hidden', 'true');
      element.style.left = x + 'px';
      element.style.top = y + 'px';
      const dark = document.body.classList.contains('home-page') || document.documentElement.dataset.theme === 'dark';
      element.style.setProperty('--moon-rgb', dark ? '219,230,245' : '105,127,158');
      document.body.append(element);
      effects.set(element, window.setTimeout(() => removeEffect(element), lifetime));
      return element;
    };
    const onPointerMove = (event: PointerEvent) => {
      if (!allowed() || event.pointerType !== 'mouse' || event.buttons) return;
      const now = performance.now();
      const dx = lastTrail.time ? event.clientX-lastTrail.x : 0;
      const dy = lastTrail.time ? event.clientY-lastTrail.y : 0;
      const distance = Math.hypot(dx,dy);
      if (lastTrail.time && (now-lastTrail.time < 48 || distance < 7)) return;
      lastTrail = { x: event.clientX, y: event.clientY, time: now };
      const direction = distance ? Math.atan2(dy,dx)*180/Math.PI : 0;
      const driftX = distance ? -dx/distance*12 : 0;
      const driftY = -10 + (distance ? -dy/distance*8 : 0);
      const turn = direction + (mistPhase++ % 2 ? 9 : -9);
      const mist = place('moon-mist', event.clientX, event.clientY, 800);
      mist.animate([
        { transform: 'translate3d(-50%,-50%,0) rotate('+direction+'deg) scale(.95,.9)', opacity: 0 },
        { offset: .16, transform: 'translate3d(-50%,-50%,0) rotate('+direction+'deg) scale(1.08,1)', opacity: .2 },
        { transform: 'translate3d(calc(-50% + '+driftX+'px),calc(-50% + '+driftY+'px),0) rotate('+turn+'deg) scale(1.8,1.45)', opacity: 0 }
      ], { duration: 760, easing: easeOut, fill: 'both' });
    };
    const onPointerDown = (event: PointerEvent) => {
      if (!allowed() || event.pointerType !== 'mouse' || event.button !== 0) return;
      if ((event.target as Element)?.closest('input,textarea,[contenteditable=true],pre,code')) return;
      const blooms = [...effects.keys()].filter(element => element.className === 'moon-bloom');
      if (blooms.length >= 2) removeEffect(blooms[0]);
      const bloom = place('moon-bloom', event.clientX, event.clientY, 1080);
      const halo = document.createElement('span');
      halo.className = 'moon-halo';
      bloom.append(halo);
      halo.animate([
        { transform: 'translate3d(-50%,-50%,0) scale(.9)', opacity: 0 },
        { offset: .14, transform: 'translate3d(-50%,-50%,0) scale(1.04)', opacity: .64 },
        { transform: 'translate3d(-50%,-50%,0) scale(2.05)', opacity: 0 }
      ], { duration: 820, easing: easeOut, fill: 'both' });
      const veil = document.createElement('span');
      veil.className = 'moon-veil';
      bloom.append(veil);
      veil.animate([
        { transform: 'translate3d(-50%,-50%,0) scale(.92)', opacity: 0 },
        { offset: .2, transform: 'translate3d(-50%,-50%,0) scale(1.18)', opacity: .52 },
        { transform: 'translate3d(-50%,-50%,0) scale(2.3)', opacity: 0 }
      ], { duration: 960, delay: 45, easing: easeOut, fill: 'both' });
      const glint = document.createElement('span');
      glint.className = 'moon-glint';
      bloom.append(glint);
      glint.animate([
        { transform: 'translate3d(-50%,-50%,0) scale(.95)', opacity: .6 },
        { transform: 'translate3d(-50%,-50%,0) scale(1.25)', opacity: 0 }
      ], { duration: 180, easing: easeOut, fill: 'both' });
    };

const bindTheme = () => {
			document.querySelectorAll<HTMLButtonElement>('.theme-toggle:not([data-bound])').forEach((button) => {
				button.dataset.bound = 'true';
				button.addEventListener('click', () => {
					const root = document.documentElement;
					const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
					root.dataset.theme = next;
					localStorage.setItem('halomoon-theme', next);
				});
			});
		};

		const enhanceCode = () => {
			document.querySelectorAll<HTMLPreElement>('pre:not([data-enhanced])').forEach((pre) => {
				pre.dataset.enhanced = 'true';
				pre.classList.add('code-window');
				const button = document.createElement('button');
				button.type = 'button'; button.className = 'copy-code'; button.ariaLabel = '复制代码'; button.title = '复制代码';
				button.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>';
				button.addEventListener('click', async () => {
					await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
					button.classList.add('copied'); button.title = '已复制';
					window.setTimeout(() => { button.classList.remove('copied'); button.title = '复制代码'; }, 1200);
				});
				pre.append(button);
			});
		};



    const init = () => { bindTheme(); enhanceCode(); };
    siteWindow.__haloSiteEffects = { init, cleanup };
    document.addEventListener('pointermove', onPointerMove, { passive: true });
    document.addEventListener('pointerdown', onPointerDown, { passive: true });
    document.addEventListener('astro:before-swap', cleanup);
    document.addEventListener('astro:page-load', init);
    document.addEventListener('visibilitychange', () => { if (document.hidden) cleanup(); });
    reduceMotion.addEventListener('change', cleanup);
    finePointer.addEventListener('change', cleanup);
  }
  siteWindow.__haloSiteEffects.init();
</script>
<style is:global>
  .moon-mist,.moon-bloom { position: fixed; z-index: 9998; pointer-events: none; }
  .moon-bloom { width: 0; height: 0; }
  .moon-mist { width: 58px; height: 30px; border-radius: 50%; opacity: 0; background: radial-gradient(ellipse at 32% 58%,rgba(var(--moon-rgb),.48),rgba(var(--moon-rgb),.14) 36%,transparent 72%),radial-gradient(ellipse at 67% 40%,rgba(var(--moon-rgb),.4),rgba(var(--moon-rgb),.09) 40%,transparent 73%),radial-gradient(ellipse at 50% 58%,rgba(var(--moon-rgb),.22),transparent 72%); }
  .moon-halo,.moon-veil,.moon-glint { position: absolute; border-radius: 50%; opacity: 0; }
  .moon-halo { width: 86px; height: 86px; background: radial-gradient(circle,rgba(var(--moon-rgb),.36),rgba(var(--moon-rgb),.18) 28%,rgba(var(--moon-rgb),.06) 52%,transparent 76%); }
  .moon-veil { width: 94px; height: 94px; background: radial-gradient(circle,transparent 28%,rgba(var(--moon-rgb),.13) 47%,rgba(var(--moon-rgb),.06) 59%,transparent 77%); }
  .moon-glint { width: 12px; height: 12px; background: radial-gradient(circle,rgba(var(--moon-rgb),.85),rgba(var(--moon-rgb),.3) 32%,transparent 72%); }
  @media (hover: hover) and (pointer: fine) {
    body { cursor: url('/cursors/lunar-pointer-v1.svg') 18 18, auto; }
    a,button,[role='button'],summary,input[type='checkbox'],input[type='radio'],body .site-header .theme-toggle,body .copy-code { cursor: url('/cursors/lunar-link-v1.svg') 18 18, pointer; }
    input:not([type='checkbox']):not([type='radio']),textarea,[contenteditable='true'],pre,code { cursor: text; }
    [disabled],.socials .disabled { cursor: not-allowed; }
  }
  @media (prefers-reduced-motion: reduce), (pointer: coarse) { .moon-mist,.moon-bloom { display: none; } }
</style>
